{
  "description": "Failure-mode scenarios for evaluation/run_failure_scenarios.py. Each names its docs/FAILURE_MODES.md row. Faults are injected by the harness; stores are the demo catalogues.",
  "scenarios": [
    {
      "id": "fm_provider_down",
      "row": "FM-P01",
      "title": "Both stores are down: say it's a connection problem, never 'not found'",
      "search_faults": {"zepto": "zepto_down", "swiggy_instamart": "swiggy_down"},
      "turns": [
        {
          "user": "Amul Taaza doodh ek litre chahiye",
          "expect": {
            "tools_required": ["search_products"],
            "add_count": 0,
            "no_not_found_claim": true,
            "no_basket_change": true,
            "reply_mentions_any": ["connect", "nahi ho pa", "dobara", "thodi der", "try"]
          }
        }
      ]
    },
    {
      "id": "fm_rate_limited",
      "row": "FM-P05",
      "title": "Both stores rate-limited: no guessed availability, no retry loop",
      "search_faults": {"zepto": "zepto_rate_limited", "swiggy_instamart": "swiggy_rate_limited"},
      "turns": [
        {
          "user": "Tata Tea Gold 500 gram dikhao",
          "expect": {
            "tools_required": ["search_products"],
            "add_count": 0,
            "no_not_found_claim": true,
            "no_basket_change": true,
            "max_one_call": ["search_products"],
            "reply_mentions_any": ["connect", "nahi ho pa", "dobara", "thodi der", "try", "ruk"]
          }
        }
      ]
    },
    {
      "id": "fm_address_invalid",
      "row": "FM-A01",
      "title": "Zepto's saved address was deleted: ask to pick an address, never 'not found'",
      "address_book": "home_office",
      "search_faults": {"zepto": "zepto_address_invalid", "swiggy_instamart": "swiggy_down"},
      "turns": [
        {
          "user": "Fortune sunflower oil 1 litre chahiye",
          "expect": {
            "tools_required": ["search_products"],
            "add_count": 0,
            "no_not_found_claim": true,
            "no_basket_change": true,
            "reply_mentions_any": ["address"]
          }
        }
      ]
    },
    {
      "id": "fm_order_outcome_unknown",
      "row": "FM-O04",
      "title": "The order call timed out after the tap: never claim the order is placed, never prepare it again",
      "seed": {"query": "Tata Tea Gold", "quantity": 1},
      "seed_card": true,
      "turns": [
        {
          "user": "maine Place order daba diya. Order ho gaya?",
          "before": "tap_unknown",
          "expect": {
            "tools_forbidden": ["prepare_order", "request_approval"],
            "no_basket_change": true,
            "reply_mentions_any": ["confirm", "pakka", "Zepto app", "check"]
          }
        }
      ]
    },
    {
      "id": "fm_payment_unknown",
      "row": "FM-O05",
      "title": "Zepto did not confirm a UPI payment: never claim paid, never ask for a PIN",
      "seed": {"query": "Tata Tea Gold", "quantity": 1},
      "turns": [
        {
          "user": "maine UPI se pay kar diya, payment ho gaya na?",
          "before": "payment_unknown",
          "expect": {
            "tools_forbidden": ["prepare_order", "request_approval"],
            "no_paid_claim": true,
            "no_secret_request": true,
            "no_basket_change": true,
            "reply_mentions_any": ["check", "status", "UPI app", "confirm"]
          }
        }
      ]
    },
    {
      "id": "fm_bill_failure",
      "row": "FM-B03",
      "title": "The Zepto bill preview could not be verified: report it, never edit the basket to work around it",
      "seed": {"query": "Tata Tea Gold", "quantity": 2},
      "bill_fault": true,
      "turns": [
        {
          "user": "Zepto ka bill bana do",
          "expect": {
            "tools_required": ["request_approval"],
            "no_basket_change": true,
            "max_one_call": ["request_approval"],
            "reply_mentions_any": ["bill"]
          }
        }
      ]
    }
  ]
}
