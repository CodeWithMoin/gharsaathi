import type { OrderStatusCard } from "./order-status.mjs";

export type Store = "swiggy_instamart" | "zepto";
export type Ref = { provider: Store; product_id: string; variant_id: string; sku_id?: string | null };
export type Money = { paise: number; display: string };
export type ListItem = { ref: Ref; name: string; brand?: string | null; pack_size?: string | null; quantity: number; store?: string; last_price?: Money | null };
export type SavedList = { id: string; name: string; items: ListItem[]; item_count: number };
export type LastOrder = { provider: Store; store: string; item_count: number; item_names: string[] };
export type QuickActions = { last_order: LastOrder | null; recent_items: ListItem[]; lists: { id: string; name: string; item_count: number }[] };
export type ChipAction = { kind: "repeat" } | { kind: "where" } | { kind: "recent"; item: ListItem } | { kind: "lists" };
export type Chip = { key: string; label: string; description: string; action: ChipAction };
export type ItemStatus = "added" | "unavailable" | "not_found" | "store_not_ready" | "store_error" | "basket_locked";
export type ItemResult = { name: string; pack_size?: string | null; store: string; provider: string; quantity: number; status: ItemStatus };
export type AddReport<B = { provider: Store; lines: unknown[] }> = { added_count: number; items: ItemResult[]; baskets: B[] };
export type ListDraft = { listId: string; name: string; items: ListItem[] };
export type HeaderChip = { orderId: string; text: string; label: string; tone: "normal" | "late" | "moving" };

export const MAX_CHIPS: number;
export const MAX_QUANTITY: number;
export const WHERE_IS_MY_ORDER: string;
export const CLEAR_CONFLICT_TEXT: string;
export const GET_BILL_HINT: string;
export function quickChips(input: { actions: QuickActions | null; orderActive: boolean; max?: number }): Chip[];
export function chipUserText(chip: Chip): string;
export function addReportText(report: AddReport<{ provider: Store; lines: unknown[] }>, options: { source: string }): { text: string; added: number; skipped: ItemResult[]; providers: Store[]; offerBill: boolean };
export function undoQuantity(basket: { lines: { ref: Ref; quantity: number }[] } | null | undefined, ref: Ref, added: number): number | null;
export function basketEditState(basket: { status: string; lines: unknown[] } | null | undefined, options?: { busy?: boolean }): { canEdit: boolean; canClear: boolean; reason: string | null };
export function clearBasketCopy(basket: { provider: string; lines: { quantity: number }[] }): { title: string; body: string; confirmLabel: string; busyLabel: string };
export function stepQuantity(quantity: number, delta: -1 | 1): number | null;
export function swapQuery(line: { name: string; pack_size?: string | null }): string;
export function listDraft(list: SavedList): ListDraft;
export function draftStep(draft: ListDraft, index: number, delta: -1 | 1): ListDraft;
export function draftRemove(draft: ListDraft, index: number): ListDraft;
export function draftRename(draft: ListDraft, name: string): ListDraft;
export function draftDirty(draft: ListDraft, list: SavedList): boolean;
export function draftPayload(draft: ListDraft): { name: string; items: { ref: Ref; quantity: number }[] } | null;
export function listNameProblem(name: string, lists?: { name: string }[]): string | null;
export function orderIsActive(card: OrderStatusCard): boolean;
export function headerOrderChip(cards: OrderStatusCard[], nowMs: number): HeaderChip | null;
