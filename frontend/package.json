{
  "name": "gharsaathi-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:ort": "node scripts/copy-ort-assets.mjs",
    "fetch:smart-turn-model": "node scripts/fetch-smart-turn-model.mjs",
    "predev": "npm run prepare:ort",
    "prebuild": "npm run prepare:ort",
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs tests/unit/*.test.mjs tests/module/*.test.mjs",
