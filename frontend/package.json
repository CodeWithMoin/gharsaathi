  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.7",
    "@phosphor-icons/react": "^2.1.10",
    "framer-motion": "^14.14.0",
    "next": "^15.3.0",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swiper": "^12.2.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "postcss": "8.5.33"
  }
