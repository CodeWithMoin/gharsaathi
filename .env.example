# Swiggy OAuth/MCP endpoints from the official Builders Club documentation.
# Demo is the safe local default: all shopping data and quotes are static and
# no commerce-provider API is called. Set to live only for deliberate MCP tests.
COMMERCE_MODE=demo
SWIGGY_RATE_LIMIT_FALLBACK_SECONDS=30
SWIGGY_BASE_URL=https://mcp.swiggy.com
SWIGGY_MCP_URL=https://mcp.swiggy.com/im

# Must exact-match a Swiggy allowlisted localhost redirect URI.
SWIGGY_OAUTH_REDIRECT_URI=http://localhost:8000/api/swiggy/oauth/callback

# Zepto's official MCP and OAuth endpoints. Zepto only allowlists callbacks
# without a port, so local development uses the small callback bridge on port 80.
ZEPTO_AUTHORIZATION_SERVER_URL=https://auth.zepto.co.in
ZEPTO_RESOURCE_URL=https://mcp.zepto.co.in
ZEPTO_MCP_URL=https://mcp.zepto.co.in/mcp
ZEPTO_OAUTH_REDIRECT_URI=http://localhost/callback
# This build intentionally refuses broader scopes. Add a reviewed provider
# capability and explicit approval flow before changing it.
ZEPTO_OAUTH_SCOPE=tools:read
# Auto-refresh Zepto's saved-address snapshot when older than this (minutes).
ZEPTO_ADDRESS_REFRESH_MAX_AGE_MIN=30
FRONTEND_URL=http://localhost:3003
CORS_ORIGINS=http://localhost:3003,http://127.0.0.1:3003

# Clerk session verification for cross-origin frontend requests. The browser
# sends its short-lived session token; the backend derives the user from the
# verified JWT subject and never accepts a browser-supplied user ID.
CLERK_SECRET_KEY=
# Optional PEM public key for networkless verification in production.
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES_CSV=http://localhost:3003,http://127.0.0.1:3003

# Generate once with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
APP_ENCRYPTION_KEY=

# Application data store. Use a dedicated database and credentials outside local development.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/equal_ai

# Optional. Without a key, memory extraction uses a small high-precision local ruleset.
OPENAI_API_KEY=
MEMORY_EXTRACTION_MODEL=gpt-4o-mini
# Background chat summaries; gpt-5.4-nano is a cheaper alternative.
CONVERSATION_SUMMARY_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
LIVE_MODEL=gpt-live-1.1
LIVE_VOICE=nira
LIVE_BACKEND_MODEL=gpt-6-luna
# Backend model reasoning effort for voice and typed chat: none|low|medium|high,
# empty = model default (medium for gpt-6-luna). Low keeps the eval quality and is faster.
LIVE_BACKEND_REASONING_EFFORT=low
# Optional Responses service tier for the backend model (auto|default|flex|priority);
# empty uses the project default. priority was ~0.2 s faster per model round.
LIVE_BACKEND_SERVICE_TIER=
# Typed chat uses LIVE_BACKEND_MODEL too; one typed turn may take at most this long.
CHAT_TURN_TIMEOUT_SECONDS=60
# Shop from a photo: vision model that reads attached photos (needs image input + structured outputs).
PHOTO_EXTRACTION_MODEL=gpt-6-luna
# Voice turn-taking: native (default) | tuned | smart_turn. See docs/voice-turn-taking.md.
VOICE_TURN_TAKING=native
# Dev diagnostic: log content-free voice sideband event types and voice start
# stage timings in ms (never transcript text).
VOICE_EVENT_LOG=false

# Optional experimental second-stage product reranker. Keep disabled until a
# labelled relevance evaluation passes; deterministic brand/availability rules
# always run first and remain authoritative.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_SECONDS=2.0
JEV_RERANKING_ENABLED=false

# Encrypted local single-user connection storage. Keep this path out of Git.
SWIGGY_TOKEN_STORE_PATH=backend/.data/swiggy_connection.enc
ZEPTO_TOKEN_STORE_PATH=backend/.data/zepto_connection.enc

# Local user-scoped support drafts and uploaded evidence. Keep out of Git.
SUPPORT_DATA_PATH=backend/.data/support
# Local persisted order-status monitors. Provider IDs stay server-side.
TRACKING_DATA_PATH=backend/.data/tracking
# Optional override. Without APP_ENCRYPTION_KEY, local development creates this
# private key once and reuses it across backend restarts.
LOCAL_ENCRYPTION_KEY_PATH=backend/.data/app_encryption.key
