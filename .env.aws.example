# Copy to .env.aws (gitignored) for scripts/aws-secrets.sh and scripts/deploy-aws.sh.
# Never commit the real file. Values here are placeholders.

# Owner-only access: the owner's Clerk user id(s) from the production Clerk
# instance (Dashboard -> Users -> the owner -> User ID). Comma-separated.
ALLOWED_USER_IDS=user_replace_me

# Clerk production instance for gharsaathi.app (public key, baked into the frontend image).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me

# Secrets: written to AWS Secrets Manager (gharsaathi/app), never to CloudFormation.
CLERK_SECRET_KEY=sk_live_replace_me
# Optional PEM public key for networkless Clerk verification.
CLERK_JWT_KEY=
# Falls back to OPENAI_API_KEY in .env when empty here.
OPENAI_API_KEY=
# Leave empty: generated once on the first run and then preserved.
APP_ENCRYPTION_KEY=

# Optional Web Push (codex/web-push); WEB_PUSH_SUBJECT is not secret.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Optional rider assist (Vobiz). Deploy with RIDER_ENABLED=true; set the Vobiz answer
# URL to https://rider.gharsaathi.app/api/rider/vobiz/answer.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# Leave empty: generated once and preserved.
RIDER_ASSIST_STREAM_SECRET=
# Optional, not secret: your Vobiz number in E.164.
RIDER_ASSIST_NUMBER=
